# SC4NNER — noms des variables seulement. Les valeurs vivent dans Coolify, jamais dans Git.
PORT=3000
# Adresse publique exacte (https), sans barre finale. Sert au contrôle d'origine des écritures.
APP_BASE_URL=
# Fichier SQLite. Dans Docker : /app/data/sc4nner.db, sur un stockage persistant Coolify monté sur /app/data.
SC4NNER_DB_PATH=./data/sc4nner.db
# Nom de l'espace (un déploiement = un espace). Ne plus le changer après la première sauvegarde.
SC4NNER_WORKSPACE_ID=sc4nner
# Compte de l'atelier : produire les trois valeurs avec `npm run hash-password -- <utilisateur>`.
SC4NNER_USERNAME=
SC4NNER_SALT=
SC4NNER_PASSWORD_HASH=
# Nombre de mandataires de confiance devant l'app (Traefik de Coolify = 1; aucun = 0).
TRUSTED_PROXY_HOPS=1
